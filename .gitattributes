* text=auto
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.pdf binary
*.png binary
*.jpg binary
*.ico binary
# Preserve upstream bytes, including CRLF, for the recorded source checksums.
docs/third-party-licenses/** binary
docs/third-party-sources/** binary
# Verification JSON retains exact bytes used by the recorded SHA-256 bindings.
docs/verification/0.2.0/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/verification/0.2.1/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/verification/real-corpus/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tests/corpus/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tests/corpus/expanded/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/verification/expanded-corpus/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/verification/0.2.2/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Raw test/build logs retain the tools' own whitespace as well as their hashes.
docs/verification/expanded-corpus/*.log -text -whitespace
docs/verification/0.2.2/*.log -text -whitespace
docs/verification/demo/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/verification/demo-library/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/verification/demo-v2/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
