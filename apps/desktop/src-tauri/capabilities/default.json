{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "PaperVault local window: user selected files and clipboard exports.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open", "dialog:allow-save",
    "clipboard-manager:allow-write-text", "clipboard-manager:allow-write-image",
    "opener:allow-open-path", "opener:allow-reveal-item-in-dir",
    "fs:allow-write-file"
  ]
}
