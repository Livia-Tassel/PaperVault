  "mapped_cues": [
    {
      "start": 0.008,
      "end": 5.008,
      "text": "8 篇真实论文，组成同一个本地论文库",
      "source_cue": 0,
      "source_clip": 0
    },
    {
      "start": 5.024,
      "end": 9.024000000000001,
      "text": "这些论文已提前完成真实的本地解析",
      "source_cue": 1,
      "source_clip": 0
    },
    {
      "start": 9.024,
      "end": 14.024,
      "text": "切换卡片视图，浏览标题和摘要",
      "source_cue": 2,
      "source_clip": 0
    },
    {
      "start": 14.024,
      "end": 19.024,
      "text": "BERT、BART、SciBERT、SimCSE 等论文集中管理",
      "source_cue": 3,
      "source_clip": 0
    },
    {
      "start": 19.32,
      "end": 24.32,
      "text": "选择三篇论文，一次添加同一个标签",
      "source_cue": 4,
      "source_clip": 0
    },
    {
      "start": 24.695,
      "end": 28.695,
      "text": "用标签整理一组预训练相关论文",
      "source_cue": 5,
      "source_clip": 0
    },
    {
      "start": 29.289,
      "end": 34.289,
      "text": "按标签筛选，快速缩小阅读范围",
      "source_cue": 6,
      "source_clip": 0
    },
    {
      "start": 34.961,
      "end": 39.961,
      "text": "输入 BERT，在整个论文库中联合检索",
      "source_cue": 7,
      "source_clip": 0
    },
    {
      "start": 39.977,
      "end": 44.977,
      "text": "论文类结果同时命中多篇论文",
      "source_cue": 8,
      "source_clip": 0
    },
    {
      "start": 44.977,
      "end": 48.977,
      "text": "同一关键词，无需逐篇打开查找",
      "source_cue": 9,
      "source_clip": 0
    },
    {
      "start": 48.977,
      "end": 53.977,
      "text": "切到表格类结果，寻找相关实验数据",
      "source_cue": 10,
      "source_clip": 0
    },
    {
      "start": 53.992,
      "end": 58.992,
      "text": "打开一条命中，确认表格内容与所属论文",
      "source_cue": 11,
      "source_clip": 0
    },
    {
      "start": 59.008,
      "end": 64.50800000000001,
      "text": "查看原文，直接定位到这篇论文的表格区域",
      "source_cue": 12,
      "source_clip": 0
    },
    {
      "start": 65.633,
      "end": 70.633,
      "text": "保持同一关键词，再查看正文类命中",
      "source_cue": 13,
      "source_clip": 0
    },
    {
      "start": 70.633,
      "end": 76.133,
      "text": "这条正文结果来自另一篇论文",
      "source_cue": 14,
      "source_clip": 0
    },
    {
      "start": 76.742,
      "end": 81.742,
      "text": "两篇论文保留在阅读标签页中，随时切换对照",
      "source_cue": 15,
      "source_clip": 0
    },
    {
      "start": 81.742,
      "end": 86.742,
      "text": "切回另一篇论文，继续刚才的阅读位置",
      "source_cue": 16,
      "source_clip": 0
    },
    {
      "start": 86.742,
      "end": 91.742,
      "text": "全库图片集中浏览，每张图保留论文来源",
      "source_cue": 17,
      "source_clip": 0
    },
    {
      "start": 91.758,
      "end": 96.758,
      "text": "按关键词筛选多篇论文中的图片",
      "source_cue": 18,
      "source_clip": 0
    },
    {
      "start": 96.789,
      "end": 100.789,
      "text": "浏览结果时，可以直接辨认每张图的出处",
      "source_cue": 19,
      "source_clip": 0
    },
    {
      "start": 101.195,
      "end": 106.195,
      "text": "在全库表格中搜索 GLUE，汇集不同论文的结果",
      "source_cue": 20,
      "source_clip": 0
    },
    {
      "start": 106.242,
      "end": 111.242,
      "text": "切换列表，查看图注、来源论文和页码",
      "source_cue": 21,
      "source_clip": 0
    },
    {
      "start": 111.242,
      "end": 115.242,
      "text": "回到论文库，继续管理和阅读这组文献",
      "source_cue": 22,
