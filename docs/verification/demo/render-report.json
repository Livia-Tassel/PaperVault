      "source_clip": 0
    },
    {
      "start": 8.018,
      "end": 11.018,
      "text": "选择 SimCSE 原始 PDF",
      "source_cue": 2,
      "source_clip": 0
    },
    {
      "start": 11.862,
      "end": 16.862,
      "text": "模型在本机处理 PDF，任务页显示实际阶段",
      "source_cue": 3,
      "source_clip": 0
    },
    {
      "start": 16.866666666666674,
      "end": 20.866666666666674,
      "text": "本地解析完成；等待过程已剪辑",
      "source_cue": 4,
      "source_clip": 1
    },
    {
      "start": 20.928666666666686,
      "end": 23.928666666666686,
      "text": "论文与提取结果保存在当前论文库",
      "source_cue": 5,
      "source_clip": 1
    },
    {
      "start": 24.584666666666664,
      "end": 29.584666666666664,
      "text": "阅读原始 PDF，右侧查看论文信息",
      "source_cue": 6,
      "source_clip": 1
    },
    {
      "start": 30.00666666666666,
      "end": 35.00666666666666,
      "text": "在 PDF 中查找 contrastive",
      "source_cue": 7,
      "source_clip": 1
    },
    {
      "start": 35.00666666666666,
      "end": 38.00666666666666,
      "text": "跳转到下一处匹配",
      "source_cue": 8,
      "source_clip": 1
    },
    {
      "start": 38.38166666666666,
      "end": 41.38166666666666,
      "text": "图片面板列出这篇论文的提取结果",
      "source_cue": 9,
      "source_clip": 1
    },
    {
      "start": 41.69466666666668,
      "end": 46.69466666666668,
      "text": "Figure G.1：查看图片、图注和来源页码",
      "source_cue": 10,
      "source_clip": 1
    },
    {
      "start": 46.69466666666668,
      "end": 51.69466666666668,
      "text": "查看原文：定位到第 17 页的图像区域",
      "source_cue": 11,
      "source_clip": 1
    },
    {
      "start": 52.241666666666674,
      "end": 57.241666666666674,
      "text": "Table A.1：直接查看结构化表格",
      "source_cue": 12,
      "source_clip": 1
    },
    {
      "start": 57.241666666666674,
      "end": 61.241666666666674,
      "text": "切换原始截图，对照表头和数值",
      "source_cue": 13,
      "source_clip": 1
    },
    {
      "start": 61.241666666666674,
      "end": 65.24166666666667,
      "text": "返回表格内容，选择需要的导出格式",
      "source_cue": 14,
      "source_clip": 1
    },
    {
      "start": 65.24166666666667,
      "end": 70.24166666666667,
      "text": "导出 CSV；系统保存对话框已略去",
      "source_cue": 15,
      "source_clip": 1
    },
    {
      "start": 70.24166666666667,
      "end": 74.24166666666667,
      "text": "CSV 不保留合并单元格；可用原图核对",
      "source_cue": 16,
      "source_clip": 1
    },
    {
      "start": 74.24166666666667,
      "end": 78.24166666666667,
      "text": "表格也能定位回第 13 页的原始区域",
      "source_cue": 17,
      "source_clip": 1
    },
    {
      "start": 78.67866666666669,
      "end": 81.67866666666669,
      "text": "为当前页添加书签",
      "source_cue": 18,
      "source_clip": 1
    },
    {
      "start": 82.75666666666669,
      "end": 87.75666666666669,
      "text": "添加阅读笔记，记录需要回看的内容",
      "source_cue": 19,
      "source_clip": 1
    },
    {
      "start": 87.75666666666669,
      "end": 90.75666666666669,
      "text": "保存笔记",
      "source_cue": 20,
      "source_clip": 1
    },
    {
      "start": 91.19466666666668,
      "end": 96.19466666666668,
      "text": "全文搜索覆盖论文、图表、正文和笔记",
      "source_cue": 21,
      "source_clip": 1
    },
    {
      "start": 96.20966666666669,
      "end": 100.20966666666669,
      "text": "也可以用中文搜索刚保存的阅读记录",
      "source_cue": 22,
      "source_clip": 1
    },
    {
      "start": 100.22566666666668,
      "end": 104.22566666666668,
      "text": "从搜索结果打开对应论文和笔记",
